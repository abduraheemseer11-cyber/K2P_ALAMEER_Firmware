diff --git a/package/firmware/wireless-regdb/wrtmax/build-regdb.sh b/package/firmware/wireless-regdb/wrtmax/build-regdb.sh
new file mode 100755
index 0000000..af9d1b3
--- /dev/null
+++ b/package/firmware/wireless-regdb/wrtmax/build-regdb.sh
@@ -0,0 +1,17 @@
+#!/bin/sh
+# build-regdb.sh <wireless-regdb build dir>
+# Adds the WrtMax 'CT' country to db.txt and rebuilds regulatory.db with upstream's own db2fw.py.
+# Run by build.sh after `make package/firmware/wireless-regdb/prepare`.
+set -e
+D="$1"; H="$(cd "$(dirname "$0")" && pwd)"
+[ -d "$D" ] || { echo "build-regdb: build dir '$D' not found"; exit 1; }
+[ -f "$D/db.txt" ] || { echo "build-regdb: $D/db.txt missing (package layout changed?)"; exit 1; }
+python3 "$H/inject-ct.py" "$D/db.txt" "$H/ct-country.txt"
+if [ -f "$D/db2fw.py" ]; then
+	( cd "$D" && python3 db2fw.py regulatory.db db.txt )
+else
+	echo "build-regdb: $D/db2fw.py missing - cannot rebuild regulatory.db"; exit 1
+fi
+[ -s "$D/regulatory.db" ] || { echo "build-regdb: regulatory.db is empty"; exit 1; }
+# marker so the verification step can prove the CT domain is inside the DB that gets installed
+grep -q '^country CT:' "$D/db.txt" && echo "build-regdb: OK ($(wc -c < "$D/regulatory.db") bytes)"
