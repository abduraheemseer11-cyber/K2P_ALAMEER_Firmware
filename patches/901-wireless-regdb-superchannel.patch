diff --git a/package/firmware/wireless-regdb/wrtmax/inject-ct.py b/package/firmware/wireless-regdb/wrtmax/inject-ct.py
new file mode 100644
index 0000000..e4ce851
--- /dev/null
+++ b/package/firmware/wireless-regdb/wrtmax/inject-ct.py
@@ -0,0 +1,25 @@
+#!/usr/bin/env python3
+"""inject-ct.py <db.txt> <ct-country.txt>  - append the WrtMax 'CT' country to a wireless-regdb db.txt (idempotent)."""
+import re, sys
+
+db_path, ct_path = sys.argv[1], sys.argv[2]
+db = open(db_path, encoding="utf-8").read()
+ct = open(ct_path, encoding="utf-8").read()
+
+if re.search(r"^country\s+CT\s*:", db, re.M):
+    print("inject-ct: CT already present - nothing to do")
+else:
+    if not db.endswith("\n"):
+        db += "\n"
+    open(db_path, "w", encoding="utf-8").write(db + ct)
+    print("inject-ct: CT country appended")
+
+# sanity: every rule line of the CT block must look like a regdb rule, block must be the last one
+db = open(db_path, encoding="utf-8").read()
+m = re.search(r"^country\s+CT\s*:.*?(?=^country\s|\Z)", db, re.M | re.S)
+rules = [l.strip() for l in m.group(0).splitlines()[1:] if l.strip() and not l.strip().startswith("#")]
+rx = re.compile(r"^\(\s*\d+\s*-\s*\d+\s*@\s*\d+\s*\)\s*,\s*\(\s*\d+(\.\d+)?\s*\)(\s*,\s*[A-Z0-9-]+)*$")
+bad = [r for r in rules if not rx.match(r)]
+if bad or not rules:
+    sys.exit("inject-ct: malformed CT rules: %r" % bad)
+print("inject-ct: %d CT rules OK" % len(rules))
