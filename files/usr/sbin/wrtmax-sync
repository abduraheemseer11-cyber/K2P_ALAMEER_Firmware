#!/bin/sh
# Regenerates the bridge, VLANs, port speeds and the 8 SSID slots from /etc/config/wrtmax
. /lib/wrtmax/common.sh

PORTS="$(wired_ports)"
[ "$(G wrtmax.net.merge_wan)" = 1 ] && PORTS="$PORTS wan"

# ---- 1. remove what we own (old bridge device, bridge-vlans, our wm_* sections)
uci -q show network | sed -n "s/^\(network\.[^=]*\)\.name='br-lan'\$/\1/p" | del_sections
uci -q show network | sed -n 's/^\(network\.[^=]*\)=bridge-vlan$/\1/p' | del_sections
uci -q show network | sed -n 's/^\(network\.wm_[^.=]*\)=.*/\1/p' | sort -u | del_sections

# ---- 2. which VLANs are in use?
VLANS=""
for p in $PORTS; do
  v=$(G wrtmax.$p.vlan); [ -n "$v" ] && [ "$v" -gt 1 ] 2>/dev/null && VLANS="$VLANS $v"
  for t in $(G wrtmax.$p.tagged); do [ "$t" -gt 1 ] 2>/dev/null && VLANS="$VLANS $t"; done
done
for n in 1 2 3 4 5 6 7 8; do
  [ "$(G wrtmax.ssid$n.enabled)" = 1 ] || continue
  v=$(G wrtmax.ssid$n.vlan); [ -n "$v" ] && [ "$v" -gt 1 ] 2>/dev/null && VLANS="$VLANS $v"
done
VLANS=$(echo $VLANS | tr ' ' '\n' | sort -nu | tr '\n' ' ')

# ---- 3. bridge
uci set network.wm_brlan=device
uci set network.wm_brlan.name=br-lan
uci set network.wm_brlan.type=bridge
for p in $PORTS; do uci add_list network.wm_brlan.ports="$p"; done
[ "$(G wrtmax.loop.stp)" = 1 ] && uci set network.wm_brlan.stp=1

if [ -z "$VLANS" ]; then
  uci set network.lan.device=br-lan
else
  uci set network.wm_brlan.vlan_filtering=1
  uci set network.lan.device=br-lan.1
  uci set network.wm_v1=bridge-vlan
  uci set network.wm_v1.device=br-lan
  uci set network.wm_v1.vlan=1
  for p in $PORTS; do
    v=$(G wrtmax.$p.vlan); [ -z "$v" ] && v=1
    [ "$v" = 1 ] && uci add_list network.wm_v1.ports="$p:u*"
  done
  for V in $VLANS; do
    uci set network.wm_v$V=bridge-vlan
    uci set network.wm_v$V.device=br-lan
    uci set network.wm_v$V.vlan=$V
    for p in $PORTS; do
      v=$(G wrtmax.$p.vlan)
      if [ "$v" = "$V" ]; then uci add_list network.wm_v$V.ports="$p:u*"; continue; fi
      for t in $(G wrtmax.$p.tagged); do
        [ "$t" = "$V" ] && uci add_list network.wm_v$V.ports="$p:t"
      done
    done
    uci set network.wm_vlan$V=interface
    uci set network.wm_vlan$V.proto=none
    uci set network.wm_vlan$V.device=br-lan.$V
  done
fi

# ---- 4. per-port speed
for p in $PORTS; do
  sp=$(G wrtmax.$p.speed)
  case "$sp" in
    100|10)
      uci set network.wm_dev_$p=device
      uci set network.wm_dev_$p.name=$p
      uci set network.wm_dev_$p.autoneg=0
      uci set network.wm_dev_$p.speed=$sp
      uci set network.wm_dev_$p.duplex=full ;;
  esac
done

# ---- 5. SSID slots
ROAM=$(G wrtmax.wifi.roaming); WDS=$(G wrtmax.wifi.wds)
for n in 1 2 3 4 5 6 7 8; do
  uci -q delete wireless.wm_ssid$n
  [ "$(G wrtmax.ssid$n.enabled)" = 1 ] || continue
  band=$(G wrtmax.ssid$n.band); r=$(radio_for_band "$band")
  [ -n "$r" ] || continue
  ssid=$(G wrtmax.ssid$n.ssid); key=$(G wrtmax.ssid$n.key); v=$(G wrtmax.ssid$n.vlan)
  uci set wireless.wm_ssid$n=wifi-iface
  uci set wireless.wm_ssid$n.device=$r
  uci set wireless.wm_ssid$n.mode=ap
  uci set wireless.wm_ssid$n.ssid="$ssid"
  if [ -n "$key" ] && [ ${#key} -ge 8 ]; then
    uci set wireless.wm_ssid$n.encryption='psk2+ccmp'
    uci set wireless.wm_ssid$n.key="$key"
    if [ "$ROAM" = 1 ]; then
      uci set wireless.wm_ssid$n.ieee80211r=1
      uci set wireless.wm_ssid$n.mobility_domain=4f57
      uci set wireless.wm_ssid$n.ft_over_ds=0
      uci set wireless.wm_ssid$n.ft_psk_generate_local=1
    fi
  else
    uci set wireless.wm_ssid$n.encryption=none
  fi
  if [ -n "$v" ] && [ "$v" -gt 1 ] 2>/dev/null; then
    uci set wireless.wm_ssid$n.network="wm_vlan$v"
  else
    uci set wireless.wm_ssid$n.network=lan
  fi
  [ "$(G wrtmax.ssid$n.isolate)" = 1 ] && uci set wireless.wm_ssid$n.isolate=1
  [ "$(G wrtmax.ssid$n.hidden)" = 1 ] && uci set wireless.wm_ssid$n.hidden=1
  [ "$WDS" = 1 ] && uci set wireless.wm_ssid$n.wds=1
  uci set wireless.wm_ssid$n.ieee80211k=1
  uci set wireless.wm_ssid$n.bss_transition=1
  uci set wireless.wm_ssid$n.wnm_sleep_mode=1
done

# ---- 6. 802.11s mesh point
uci -q delete wireless.wm_mesh
if [ "$(G wrtmax.mesh.enabled)" = 1 ]; then
  r=$(radio_for_band "$(G wrtmax.mesh.band)")
  if [ -n "$r" ]; then
    uci set wireless.wm_mesh=wifi-iface
    uci set wireless.wm_mesh.device=$r
    uci set wireless.wm_mesh.mode=mesh
    uci set wireless.wm_mesh.mesh_id="$(G wrtmax.mesh.id)"
    uci set wireless.wm_mesh.network=lan
    uci set wireless.wm_mesh.mesh_fwding=1
    key=$(G wrtmax.mesh.key)
    if [ ${#key} -ge 8 ]; then
      uci set wireless.wm_mesh.encryption=sae
      uci set wireless.wm_mesh.key="$key"
    else
      uci set wireless.wm_mesh.encryption=none
    fi
  fi
fi

uci commit network
uci commit wireless
exit 0
