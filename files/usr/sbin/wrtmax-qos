#!/bin/sh
# wrtmax-qos apply | clear | status | watch
# Genuine per-client shaping (no packet dropping policers):
#   download  = HTB class + fq_codel/cake leaf on the EGRESS of every AP interface, matched on destination MAC
#   upload    = ingress on every AP interface -> mirred redirect to IFB (ifb0) -> HTB + fq_codel/cake, matched on source MAC
# Limits are stored in UCI as  wrtmax.lim_<mac>  { mac, down, up }  in kbit/s (0 = unlimited).
# MAC matching uses raw u32 offsets relative to the network header (-14 = destination MAC, -8 = source MAC),
# so it works for any L3 protocol, for DHCP-less setups and when a client changes IP.
. /lib/wrtmax/common.sh
IFB=ifb0
LOG() { logger -t wrtmax-qos "$*"; }

leaf() {  # leaf <dev> <parent> <handle>
  case "$(G wrtmax.qos.qdisc)" in
    cake) tc qdisc add dev "$1" parent "$2" handle "$3": cake besteffort flows 2>/dev/null || tc qdisc add dev "$1" parent "$2" handle "$3": fq_codel ;;
    *)    tc qdisc add dev "$1" parent "$2" handle "$3": fq_codel limit 800 flows 512 2>/dev/null ;;
  esac
}
clear_all() {
  for i in $(ap_ifaces) $(ls /sys/class/net 2>/dev/null | grep -E '^phy[0-9]+-(ap|sta)[0-9]+$'); do
    tc qdisc del dev "$i" root 2>/dev/null; tc qdisc del dev "$i" ingress 2>/dev/null
  done
  tc qdisc del dev $IFB root 2>/dev/null
}
mac_down_match() {  # dst MAC aa:bb:cc:dd:ee:ff -> u32 matches
  h=$(echo "$1" | tr -d ':' | tr 'A-F' 'a-f')
  echo "match u32 0x$(echo $h | cut -c1-8) 0xffffffff at -14 match u16 0x$(echo $h | cut -c9-12) 0xffff at -10"
}
mac_up_match() {    # src MAC
  h=$(echo "$1" | tr -d ':' | tr 'A-F' 'a-f')
  echo "match u16 0x$(echo $h | cut -c1-4) 0xffff at -8 match u32 0x$(echo $h | cut -c5-12) 0xffffffff at -6"
}

apply() {
  [ "$(G wrtmax.qos.enabled)" = 1 ] || { clear_all; exit 0; }
  command -v tc >/dev/null || { LOG "tc not installed"; exit 1; }
  LIMS=$(uci -q show wrtmax | sed -n 's/^wrtmax\.\(lim_[^.=]*\)=limit$/\1/p')
  clear_all
  [ -n "$LIMS" ] || exit 0
  ip link show $IFB >/dev/null 2>&1 || ip link add $IFB type ifb 2>/dev/null
  ip link set $IFB up 2>/dev/null
  tc qdisc add dev $IFB root handle 2: htb default ffff
  tc class add dev $IFB parent 2: classid 2:1 htb rate 1000mbit
  tc class add dev $IFB parent 2:1 classid 2:ffff htb rate 1000mbit ceil 1000mbit
  APS=$(ap_ifaces)
  for i in $APS; do
    tc qdisc add dev "$i" root handle 1: htb default ffff
    tc class add dev "$i" parent 1: classid 1:1 htb rate 1000mbit
    tc class add dev "$i" parent 1:1 classid 1:ffff htb rate 1000mbit ceil 1000mbit
    tc qdisc add dev "$i" handle ffff: ingress
  done
  n=16; cnt=0
  for s in $LIMS; do
    mac=$(G wrtmax.$s.mac); d=$(G wrtmax.$s.down); u=$(G wrtmax.$s.up)
    [ -n "$mac" ] || continue
    id=$(printf '%x' $n); n=$((n+1)); cnt=$((cnt+1))
    # upload side (shared IFB)
    if [ "${u:-0}" -gt 0 ] 2>/dev/null; then
      tc class add dev $IFB parent 2:1 classid 2:$id htb rate ${u}kbit ceil ${u}kbit burst 16k cburst 16k quantum 1514
      leaf $IFB 2:$id $id
      tc filter add dev $IFB parent 2: protocol all prio 1 u32 $(mac_up_match "$mac") flowid 2:$id
    fi
    for i in $APS; do
      if [ "${d:-0}" -gt 0 ] 2>/dev/null; then
        tc class add dev "$i" parent 1:1 classid 1:$id htb rate ${d}kbit ceil ${d}kbit burst 16k cburst 16k quantum 1514
        leaf "$i" 1:$id $id
        tc filter add dev "$i" parent 1: protocol all prio 1 u32 $(mac_down_match "$mac") flowid 1:$id
      fi
      if [ "${u:-0}" -gt 0 ] 2>/dev/null; then
        tc filter add dev "$i" parent ffff: protocol all prio 1 u32 $(mac_up_match "$mac") \
          action mirred egress redirect dev $IFB
      fi
    done
  done
  # unlimited default classes get a fair-queue leaf so everybody else keeps low latency too
  for i in $APS; do leaf "$i" 1:ffff fe; done
  leaf $IFB 2:ffff fe
  LOG "applied $cnt client limit(s) on: $(echo $APS)"
}

status() {
  printf '{"enabled":%s,"qdisc":"%s","clients":%s,"ifb":%s,"ifaces":[' "$([ "$(G wrtmax.qos.enabled)" = 1 ] && echo true || echo false)" \
    "$(G wrtmax.qos.qdisc)" "$(uci -q show wrtmax | grep -c '=limit$')" "$(ip link show $IFB >/dev/null 2>&1 && echo true || echo false)"
  f=1; for i in $(ap_ifaces); do
    [ $f = 1 ] || printf ','; f=0
    printf '{"dev":"%s","htb":%s}' "$i" "$(tc qdisc show dev "$i" 2>/dev/null | grep -q 'htb 1:' && echo true || echo false)"
  done; echo ']}'
}

watch() {
  SIG=""
  while sleep 5; do
    NS="$(ap_ifaces | tr '\n' ' ')|$(uci -q show wrtmax | grep -E '^wrtmax\.(lim_|qos)' | md5sum | cut -c1-12)"
    [ "$NS" = "$SIG" ] && continue
    SIG="$NS"; ( apply )
  done
}

case "$1" in
  apply) apply ;;
  clear) clear_all ;;
  status) status ;;
  watch) watch ;;
  *) echo "usage: $0 apply|clear|status|watch"; exit 1 ;;
esac
