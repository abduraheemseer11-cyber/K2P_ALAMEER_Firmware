#!/bin/sh
# wrtmax-cpugov  daemon | apply | status
# CPU & power management for the MT7621A. Touches ONLY /sys/devices/system/cpu and IRQ affinity -
# never any Wi-Fi radio / driver parameter.
#
# Mode "cpufreq"  : the kernel exposes /sys/devices/system/cpu/cpu0/cpufreq  -> real governors
#                   (performance|powersave|ondemand|conservative|schedutil); "adaptive" = this daemon
#                   switches between powersave / schedutil / performance with hysteresis.
# Mode "parking"  : no cpufreq driver for the MT7621 PLL (the normal case) -> verified fallback:
#                   * core parking: the 2nd core (cpu2+cpu3, if CONFIG_HOTPLUG_CPU) is taken offline when idle
#                   * IRQ affinity: Ethernet and PCIe/Wi-Fi interrupts are split across the online CPUs
#                   The governor names keep their meaning (see thresholds below).
. /lib/wrtmax/common.sh
CPUD=/sys/devices/system/cpu; ST=/var/run/wrtmax-cpugov.json
has_cpufreq() { [ -r $CPUD/cpu0/cpufreq/scaling_governor ]; }
can_park()    { [ -e $CPUD/cpu2/online ]; }
online_list() { cat $CPUD/online 2>/dev/null; }
cores_online() { n=0; for c in $CPUD/cpu[0-9]*; do [ "$(cat $c/online 2>/dev/null || echo 1)" = 1 ] && n=$((n+1)); done; echo $n; }

set_core2() {   # 1 = online, 0 = parked
  can_park || return 1
  for c in 2 3; do [ -e $CPUD/cpu$c/online ] && echo "$1" > $CPUD/cpu$c/online 2>/dev/null; done
}

irq_tune() {   # ethernet -> cpu0/1, PCIe (Wi-Fi) -> cpu2/3 when online, otherwise everything on the online CPUs
  [ "$(G wrtmax.cpu.irq_tune)" = 1 ] || return 0
  [ -d /proc/irq ] || return 0
  if [ "$(cores_online)" -ge 4 ]; then em=3; wm=c; else em=3; wm=3; fi    # hex CPU masks
  awk '/ethernet|mtk_soc_eth|1e100000/ {sub(":","",$1); print "e", $1} /mt76|mt7615|pcie|mt7621-pci/ {sub(":","",$1); print "w", $1}' /proc/interrupts | while read -r k n; do
    case "$n" in ''|*[!0-9]*) continue ;; esac
    if [ "$k" = e ]; then echo $em > /proc/irq/$n/smp_affinity 2>/dev/null; else echo $wm > /proc/irq/$n/smp_affinity 2>/dev/null; fi
  done
}

util() {   # whole-system busy % over $1 seconds
  set -- ${1:-2}
  read -r _ u1 n1 s1 i1 w1 q1 sq1 _ < /proc/stat; sleep "$1"; read -r _ u2 n2 s2 i2 w2 q2 sq2 _ < /proc/stat
  t1=$((u1+n1+s1+i1+w1+q1+sq1)); t2=$((u2+n2+s2+i2+w2+q2+sq2)); dt=$((t2-t1)); di=$(( (i2+w2)-(i1+w1) ))
  [ $dt -gt 0 ] && echo $(( (dt-di)*100/dt )) || echo 0
}

temp_c() { for f in /sys/class/thermal/thermal_zone*/temp; do [ -r "$f" ] && { echo $(( $(cat $f) / 1000 )); return; }; done; echo ""; }

write_state() {   # write_state <mode> <governor> <util>
  tc_=$(temp_c)
  gv=""; avail=""; cur=""
  if has_cpufreq; then gv=$(cat $CPUD/cpu0/cpufreq/scaling_governor); avail=$(cat $CPUD/cpu0/cpufreq/scaling_available_governors); cur=$(cat $CPUD/cpu0/cpufreq/scaling_cur_freq 2>/dev/null); fi
  cat > $ST.tmp <<JSON
{"mode":"$1","governor":"$2","util":${3:-0},"cores_online":$(cores_online),"cores_total":$(ls -d $CPUD/cpu[0-9]* 2>/dev/null | wc -l),
 "cpufreq":$(has_cpufreq && echo true || echo false),"can_park":$(can_park && echo true || echo false),
 "kernel_governor":"$gv","available":"$avail","cur_khz":${cur:-0},"temp":${tc_:-null},"time":$(date +%s)}
JSON
  mv $ST.tmp $ST
}

# map a governor name + current utilisation to a desired performance level: 0 = low, 1 = high
decide() {  # decide <governor> <util> <current level> <low_count_var>
  g=$1; u=$2; lvl=$3
  case "$g" in
    performance) echo 1 ;;
    powersave)   echo 0 ;;
    conservative) if [ "$u" -ge 80 ]; then echo 1; elif [ "$u" -le 10 ]; then echo 0; else echo "$lvl"; fi ;;
    schedutil)    if [ "$u" -ge 50 ]; then echo 1; elif [ "$u" -le 15 ]; then echo 0; else echo "$lvl"; fi ;;
    *)            if [ "$u" -ge 60 ]; then echo 1; elif [ "$u" -le 20 ]; then echo 0; else echo "$lvl"; fi ;;   # ondemand / adaptive
  esac
}

apply_level() {  # apply_level <mode> <level>
  if [ "$1" = cpufreq ]; then
    g=$(G wrtmax.cpu.governor)
    case "$g" in
      adaptive) [ "$2" = 1 ] && kg=performance || kg=powersave ;;
      *) kg=$g ;;
    esac
    case " $(cat $CPUD/cpu0/cpufreq/scaling_available_governors) " in *" $kg "*) ;; *) kg=$(cut -d' ' -f1 $CPUD/cpu0/cpufreq/scaling_available_governors) ;; esac
    for c in $CPUD/cpu[0-9]*/cpufreq; do
      [ -w $c/scaling_governor ] && echo "$kg" > $c/scaling_governor 2>/dev/null
      mn=$(G wrtmax.cpu.min_khz); mx=$(G wrtmax.cpu.max_khz)
      [ -n "$mn" ] && [ -w $c/scaling_min_freq ] && echo "$mn" > $c/scaling_min_freq 2>/dev/null
      [ -n "$mx" ] && [ -w $c/scaling_max_freq ] && echo "$mx" > $c/scaling_max_freq 2>/dev/null
    done
  else
    set_core2 "$2"
  fi
}

daemon() {
  lvl=1; low=0; cur_applied=""
  trap 'exit 0' TERM INT
  while :; do
    if [ "$(G wrtmax.cpu.enabled)" != 1 ]; then can_park && set_core2 1; write_state off disabled 0; sleep 10; continue; fi
    gov=$(G wrtmax.cpu.governor); [ -n "$gov" ] || gov=adaptive
    has_cpufreq && mode=cpufreq || { can_park && mode=parking || mode=irq-only; }
    iv=$(G wrtmax.cpu.interval); [ -n "$iv" ] && [ "$iv" -ge 1 ] 2>/dev/null || iv=5
    u=$(util 2)
    want=$(decide "$gov" "$u" "$lvl")
    temp=$(temp_c); [ -n "$temp" ] && [ "$temp" -ge 80 ] && want=0          # thermal guard: never ramp up when hot
    if [ "$want" = 0 ] && [ "$lvl" = 1 ]; then              # hysteresis: stay high for a few quiet samples before dropping
      low=$((low+1)); case "$gov" in conservative) need=6 ;; powersave) need=1 ;; *) need=3 ;; esac
      [ $low -ge $need ] || want=1
    else low=0; fi
    if [ "$want" != "$cur_applied" ] || [ "$mode" != "$prev_mode" ]; then
      [ "$mode" != irq-only ] && apply_level "$mode" "$want"
      irq_tune
      logger -t wrtmax-cpugov "mode=$mode governor=$gov util=${u}% level=$want cores_online=$(cores_online)"
      cur_applied=$want; prev_mode=$mode
    fi
    lvl=$want
    write_state "$mode" "$gov" "$u"
    sleep $iv
  done
}

case "$1" in
  daemon) daemon ;;
  apply)  /etc/init.d/wrtmax restart >/dev/null 2>&1 ;;
  status) [ -f $ST ] && cat $ST || echo '{"mode":"stopped"}' ;;
  *) echo "usage: $0 daemon|apply|status"; exit 1 ;;
esac
