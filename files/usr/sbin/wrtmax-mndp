#!/usr/bin/ucode
// MikroTik Neighbor Discovery (MNDP) announcer - makes the router show up in Winbox "Neighbors"
'use strict';
import * as socket from 'socket';
import * as struct from 'struct';
import * as fs from 'fs';
import { connect } from 'ubus';
import { cursor } from 'uci';

function tlv(t, v) { return struct.pack('>HH', t, length(v)) + v; }
let seq = 0;
const ub = connect();
const uci = cursor();

function packet() {
	let host = uci.get('system', '@system[0]', 'hostname') || 'WrtMax';
	let st = ub.call('network.interface.lan', 'status') || {};
	let ip = (st['ipv4-address'] && st['ipv4-address'][0]) ? st['ipv4-address'][0].address : '192.168.1.20';
	let mac = trim(fs.readfile('/sys/class/net/br-lan/address') || '00:00:00:00:00:00');
	let up = int(split(fs.readfile('/proc/uptime') || '0', '.')[0]);
	seq++;
	return struct.pack('>HH', 0, seq) +
		tlv(1, hexdec(replace(mac, ':', ''))) +
		tlv(5, host) +
		tlv(7, 'WrtMax 1.0') +
		tlv(8, 'WrtMax K2P') +
		tlv(10, struct.pack('<I', up)) +
		tlv(11, 'wrtmax') +
		tlv(12, 'Phicomm K2P') +
		tlv(16, 'br-lan') +
		tlv(17, chr(...iptoarr(ip)));
}

const s = socket.create(socket.AF_INET, socket.SOCK_DGRAM);
s.setopt(socket.SOL_SOCKET, socket.SO_BROADCAST, true);
s.setopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, true);
s.bind({ address: '0.0.0.0', port: 5678 });
for (;;) {
	if (!s.send(packet(), 0, { address: '255.255.255.255', port: 5678 }))
		warn('mndp send failed: ' + s.error() + '\n');
	system(['sleep', '30']);
}
