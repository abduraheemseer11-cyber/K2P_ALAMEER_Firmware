#!/bin/sh
# Builds the "wrtmax_guard" nftables bridge table:
#   - drops rogue DHCP offers coming from Wi-Fi (and from non-uplink wired ports if uplinks are set)
#   - drops ARP packets from Wi-Fi that claim the gateway / router IP (NetCut / ARP spoofing)
#   - drops rogue IPv6 router advertisements from Wi-Fi
#   - blocked MACs   (speed limits are real tc shaping now: see wrtmax-qos)
. /lib/wrtmax/common.sh
T="table bridge wrtmax_guard"
nft list $T >/dev/null 2>&1 && nft delete $T
[ "$(G wrtmax.guard.enabled)" = 1 ] || exit 0
command -v nft >/dev/null || exit 0

APS=""; for i in $(ap_ifaces); do APS="$APS \"$i\","; done; APS="${APS%,}"
LANIP=$(G network.lan.ipaddr); GW=$(G network.lan.gateway)
PROT="$LANIP $GW $(G wrtmax.guard.protect)"
F=/tmp/wrtmax-guard.nft
{
  echo "$T {"
  echo "  chain forward {"
  echo "    type filter hook forward priority -200; policy accept;"
  for m in $(G wrtmax.guard.blocked); do echo "    ether saddr $m drop"; echo "    ether daddr $m drop"; done
  if [ -n "$APS" ]; then
    echo "    iifname { $APS } udp sport 67 udp dport 68 drop"
    for ip in $PROT; do
      case "$ip" in *.*.*.*) echo "    iifname { $APS } ether type arp arp saddr ip $ip drop" ;; esac
    done
    echo "    iifname { $APS } meta l4proto ipv6-icmp icmpv6 type nd-router-advert drop"
  fi
  UPL=""; for p in $(wired_ports) wan; do [ "$(G wrtmax.$p.role)" = uplink ] && UPL="$UPL $p"; done
  if [ -n "$UPL" ]; then
    NU=""
    for p in $(wired_ports) wan; do
      case " $UPL " in *" $p "*) ;; *) NU="$NU \"$p\"," ;; esac
    done
    NU="${NU%,}"; [ -n "$NU" ] && echo "    iifname { $NU } udp sport 67 udp dport 68 drop"
  fi
  echo "  }"
  echo "}"
} > $F
nft -f $F 2>&1 | logger -t wrtmax-guard
exit 0
