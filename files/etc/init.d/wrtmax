#!/bin/sh /etc/rc.common
START=95
USE_PROCD=1

start_service() {
  . /lib/wrtmax/common.sh
  # make sure hardware/software flow offloading stays on (also after factory reset)
  [ "$(G firewall.@defaults[0].flow_offloading)" = 1 ] && [ "$(G firewall.@defaults[0].flow_offloading_hw)" = 1 ] || {
    uci set firewall.@defaults[0].flow_offloading=1; uci set firewall.@defaults[0].flow_offloading_hw=1
    uci commit firewall; /etc/init.d/firewall reload >/dev/null 2>&1; logger -t wrtmax "flow offloading re-enabled"
  }
  procd_open_instance guardd
  procd_set_param command /usr/sbin/wrtmax-guardd
  procd_set_param respawn
  procd_close_instance
  # per-client tc shaping: apply now, then watch for Wi-Fi interface / limit changes
  procd_open_instance qosd
  procd_set_param command /usr/sbin/wrtmax-qos watch
  procd_set_param respawn
  procd_close_instance
  # CPU & power governor (independent of Wi-Fi)
  procd_open_instance cpugov
  procd_set_param command /usr/sbin/wrtmax-cpugov daemon
  procd_set_param respawn
  procd_close_instance
  # layer-2 loop guard
  if [ -x /usr/sbin/wrtmax-loopguard ]; then
    gen_loopguard_conf
    procd_open_instance loopguard
    procd_set_param command /usr/sbin/wrtmax-loopguard -f /var/etc/wrtmax-loopguard.conf
    procd_set_param respawn
    procd_close_instance
  fi
  # MNDP (Winbox neighbors) - needs ucode-mod-socket
  if [ -e /usr/lib/ucode/socket.so ]; then
    procd_open_instance mndp
    procd_set_param command /usr/bin/ucode /usr/sbin/wrtmax-mndp
    procd_set_param respawn 3600 10 0
    procd_close_instance
  fi
  grep -q wrtmax-watchdog /etc/crontabs/root 2>/dev/null || {
    echo '* * * * * /usr/sbin/wrtmax-watchdog' >> /etc/crontabs/root
    /etc/init.d/cron restart 2>/dev/null
  }
}
service_triggers() { procd_add_reload_trigger wrtmax; }
reload_service() {
  . /lib/wrtmax/common.sh
  /usr/sbin/wrtmax-guard
  gen_loopguard_conf; /usr/sbin/wrtmax-loopguard -c reload >/dev/null 2>&1
  /usr/sbin/wrtmax-qos apply
}
