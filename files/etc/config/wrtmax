config settings 'net'
	option mode 'ap'
	option merge_wan '1'

config settings 'wifi'
	option roaming '0'
	option wds '0'
	# Super Channel / Compliance-Test domain (country CT): channels 1-14 / 36-177, up to 27 dBm
	option super '0'
	option prev_country 'US'

config settings 'mesh'
	option enabled '0'
	option band '5g'
	option id 'WrtMax-Mesh'
	option key ''

config settings 'guard'
	option enabled '1'
	option protect ''

# Layer-2 loop guard (wrtmax-loopguard).  Port roles live in the port sections: auto | uplink | downlink
config settings 'loop'
	option enabled '1'
	option probe_ms '100'
	option storm_pps '20000'
	option recover_s '0'
	option stp '0'

# per-client shaping (tc + HTB + fq_codel/cake + IFB). Clients: config limit 'lim_<mac>' (down/up in kbit/s)
config settings 'qos'
	option enabled '1'
	option qdisc 'fq_codel'

# CPU & power (wrtmax-cpugov) - independent of every Wi-Fi/driver setting
config settings 'cpu'
	option enabled '1'
	# performance | powersave | ondemand | conservative | schedutil | adaptive
	option governor 'adaptive'
	option interval '5'
	option irq_tune '1'
	option min_khz ''
	option max_khz ''

config settings 'watchdog'
	option enabled '1'
	option target ''
	option fails '5'
	option wifi '1'
	option reboot_on_fail '0'
	option reboot_at ''

config settings 'ota'
	option url ''

