#!/bin/sh
# WrtMax factory defaults. This runs on first boot AND again after every factory reset
# (button or UI), because it lives in the read-only firmware image.
. /lib/wrtmax/common.sh
. /etc/wrtmax_release 2>/dev/null

# ---- system / branding -------------------------------------------------------
uci -q batch <<UCI
set system.@system[0].hostname='WrtMax'
set system.@system[0].timezone='AST-3'
set system.@system[0].zonename='Asia/Aden'
set system.@system[0].description='WrtMax Firmware Solutions - support 776 538 297'
set luci.main.lang='en'
commit system
commit luci
UCI
if [ -f /etc/openwrt_release ]; then
  sed -i "s|^DISTRIB_DESCRIPTION=.*|DISTRIB_DESCRIPTION='WrtMax Firmware Solutions ${WRTMAX_VERSION} (OpenWrt ${WRTMAX_OPENWRT}) - Support 776 538 297'|" /etc/openwrt_release
fi

# ---- network: 192.168.1.20, only LAN, all 5 ports bridged ----------------------
uci -q delete network.wan
uci -q delete network.wan6
uci -q delete network.globals.ula_prefix
uci -q delete network.lan.ip6assign
uci set network.lan.proto='static'
uci set network.lan.ipaddr='192.168.1.20'
uci set network.lan.netmask='255.255.255.0'
uci set network.lan.gateway='192.168.1.1'
uci -q delete network.lan.dns
uci add_list network.lan.dns='192.168.1.1'
uci commit network

# DHCP server off (the MikroTik / main router hands out addresses)
uci set dhcp.lan=dhcp
uci set dhcp.lan.interface='lan'
uci set dhcp.lan.ignore='1'
uci set dhcp.lan.dhcpv6='disabled'
uci set dhcp.lan.ra='disabled'
uci set dhcp.lan.ndp='disabled'
uci -q delete dhcp.wan
uci commit dhcp

# ---- firewall: hardware flow offloading ----------------------------------------
uci set firewall.@defaults[0].flow_offloading='1'
uci set firewall.@defaults[0].flow_offloading_hw='1'
fw_zone_nets lan lan
fw_zone_nets wan
uci commit firewall

# packet steering spreads RX load over the 4 MT7621 threads (valid for 23.05)
uci -q set network.globals.packet_steering='1'
uci -q commit network

# ---- wireless radios ---------------------------------------------------------------
[ -s /etc/config/wireless ] || wifi config
for r in $(uci -q show wireless | sed -n 's/^wireless\.\([^.=]*\)=wifi-device$/\1/p'); do
  b=$(G wireless.$r.band)
  [ -z "$b" ] && case "$(G wireless.$r.hwmode)" in 11a) b=5g ;; *) b=2g ;; esac
  uci set wireless.$r.disabled='0'
  uci set wireless.$r.country="$([ "$(G wrtmax.wifi.super)" = 1 ] && echo CT || echo US)"
  uci set wireless.$r.cell_density='0'
  case "$b" in
    2g) uci set wireless.$r.channel='6';  uci set wireless.$r.htmode='HT20';  uci set wireless.$r.txpower='20' ;;
    5g) uci set wireless.$r.channel='36'; uci set wireless.$r.htmode='VHT40'; uci set wireless.$r.txpower='23' ;;
  esac
done
# remove the stock "OpenWrt" interfaces - the SSID slots in /etc/config/wrtmax replace them
for s in $(uci -q show wireless | sed -n 's/^wireless\.\(default_radio[0-9]*\)=wifi-iface$/\1/p'); do uci -q delete wireless.$s; done
uci commit wireless

# ---- generate bridge + SSIDs from /etc/config/wrtmax -----------------------------
/usr/sbin/wrtmax-sync

# ---- Winbox / LLDP / CDP neighbor discovery ---------------------------------------
uci -q set lldpd.config.enable_cdp='1'
uci -q set lldpd.config.enable_fdp='0'
uci -q set lldpd.config.lldp_description='WrtMax K2P - 192.168.1.20'
uci -q commit lldpd
/etc/init.d/lldpd enable 2>/dev/null

# ---- LuCI branding: CSS + JS injected into the theme header ----------------------
H=/usr/share/ucode/luci/template/themes/bootstrap/header.ut
[ -f "$H" ] || H=$(ls /usr/lib/lua/luci/view/themes/bootstrap/header.htm 2>/dev/null)
if [ -f "$H" ] && ! grep -q wrtmax "$H"; then
  sed -i 's#</head>#<link rel="stylesheet" href="/luci-static/wrtmax/wrtmax.css"><link rel="icon" href="/luci-static/wrtmax/favicon.png"><script defer src="/luci-static/wrtmax/brand.js"></script></head>#' "$H"
  grep -q wrtmax "$H" || logger -t wrtmax "could not patch $H"
else
  [ -f "$H" ] || logger -t wrtmax "theme header not found, branding injection skipped"
fi

# ---- services -----------------------------------------------------------------------
/etc/init.d/wrtmax enable
/etc/init.d/sysctl restart 2>/dev/null
/etc/init.d/cron enable 2>/dev/null
rm -f /tmp/luci-indexcache* 2>/dev/null
exit 0
