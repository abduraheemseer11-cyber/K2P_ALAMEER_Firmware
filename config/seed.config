# ===== WrtMax K2P seed (.config) - OpenWrt v23.05.5, ramips/mt7621, Phicomm K2P (16 MB) =====
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_phicomm_k2p=y

# ---- images: squashfs only, small blocks overhead, no extras
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_SQUASHFS_BLOCKSIZE=1024
# CONFIG_TARGET_ROOTFS_EXT4FS is not set
# CONFIG_TARGET_ROOTFS_TARGZ is not set
# CONFIG_TARGET_ROOTFS_INITRAMFS is not set
# CONFIG_SIGNED_PACKAGES is not set
# CONFIG_ALL_NONSHARED is not set
# CONFIG_ALL_KMODS is not set
# CONFIG_ALL is not set

# ---- build speed / disk
CONFIG_CCACHE=y
CONFIG_AUTOREMOVE=y

# ---- strip kernel bloat (size)
# CONFIG_KERNEL_DEBUG_INFO is not set
# CONFIG_KERNEL_KALLSYMS is not set
# CONFIG_KERNEL_DEBUG_FS is not set
# CONFIG_KERNEL_MAGIC_SYSRQ is not set
# CONFIG_KERNEL_SWAP is not set
# CONFIG_KERNEL_AIO is not set
# CONFIG_KERNEL_IP_MROUTE is not set
# CONFIG_KERNEL_PERF_EVENTS is not set
# CONFIG_KERNEL_PROFILING is not set
# CONFIG_PACKAGE_MAC80211_DEBUGFS is not set
# CONFIG_PACKAGE_MAC80211_TRACING is not set
# CONFIG_IPV6 is not set

# ---- Wi-Fi: one TLS stack (mbedtls) everywhere, full wpad for 11r/k/v + mesh + SAE
# CONFIG_PACKAGE_wpad-basic-wolfssl is not set
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set
CONFIG_PACKAGE_wpad-mbedtls=y
CONFIG_PACKAGE_MAC80211_MESH=y
# CONFIG_PACKAGE_libustream-wolfssl is not set
CONFIG_PACKAGE_libustream-mbedtls=y
