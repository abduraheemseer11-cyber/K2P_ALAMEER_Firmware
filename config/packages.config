# ===== packages included in the image =====
# --- LuCI (explicit list instead of the "luci" collection => no unused apps)
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-opkg=y
CONFIG_PACKAGE_luci-proto-ppp=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_rpcd-mod-luci=y
CONFIG_PACKAGE_rpcd-mod-iwinfo=y
CONFIG_PACKAGE_luci-i18n-base-ar=y
CONFIG_PACKAGE_luci-i18n-firewall-ar=y
CONFIG_PACKAGE_luci-i18n-opkg-ar=y

# --- routing / WAN modes
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_relayd=y

# --- (1) NAT / flow offloading (kmods are built into the kernel, see kernel fragment)
CONFIG_PACKAGE_kmod-nf-flow=y
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_nftables-json=y
CONFIG_PACKAGE_kmod-nft-bridge=y

# --- (3) true per-client shaping: tc + HTB + fq_codel/cake + IFB
CONFIG_PACKAGE_tc-full=y
CONFIG_PACKAGE_kmod-sched-core=y
CONFIG_PACKAGE_kmod-sched-cake=y
CONFIG_PACKAGE_kmod-ifb=y
CONFIG_PACKAGE_iptables-mod-conntrack-extra=y
CONFIG_PACKAGE_ip-full=y

# --- (4) Layer-2 loop prevention / port isolation
CONFIG_PACKAGE_kmod-br-netfilter=y
CONFIG_PACKAGE_ebtables-nft=y
CONFIG_PACKAGE_kmod-ebtables=y
CONFIG_PACKAGE_wrtmax-loopguard=y

# --- helpers used by the WrtMax pages
CONFIG_PACKAGE_iwinfo=y
CONFIG_PACKAGE_iw=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_ucode=y
CONFIG_PACKAGE_ucode-mod-uci=y
CONFIG_PACKAGE_ucode-mod-ubus=y
CONFIG_PACKAGE_ucode-mod-fs=y
CONFIG_PACKAGE_jsonfilter=y
CONFIG_PACKAGE_uclient-fetch=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_lldpd=y
